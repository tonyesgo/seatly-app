{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_NO_CLEAN": "true"
      },
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "cache": {
        "key": "firebase-dynamic-frameworks"
      },
      "android": {
        "gradleCommand": ":app:bundleRelease"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "tonyesgo@hotmail.com",
        "ascAppId": "6754407162",
        "appleTeamId": "5E4VQU7VVM"
      }
    }
  }
}